# =====================================================================
# Montañas del Tenorio — environment variables
# Copy to .env for local development. In production set them in
# Vercel → Project → Settings → Environment Variables, then redeploy.
# NEVER commit real values. PUBLIC_* values are visible in the browser.
# =====================================================================

# Canonical URL, e.g. https://www.your-domain.com (no trailing slash).
# Empty = Vercel production URL is used.
PUBLIC_SITE_URL=

# --- Contact (empty = the related button is hidden) -------------------
# WhatsApp number in international format, digits only (e.g. 506XXXXXXXX)
PUBLIC_WHATSAPP_NUMBER=
PUBLIC_CONTACT_EMAIL=

# --- Social / listings ----------------------------------------------------
PUBLIC_INSTAGRAM_URL=
PUBLIC_FACEBOOK_URL=
PUBLIC_TIKTOK_URL=
PUBLIC_BOOKING_URL=
PUBLIC_AIRBNB_URL=
# Tripadvisor listing (optional; defaults to the official listing in src/data/site.ts)
PUBLIC_TRIPADVISOR_URL=

# --- Location ---------------------------------------------------------------
# Google Maps place link (Share → Copy link)
PUBLIC_MAPS_URL=
# Optional: Google Maps embed src (Share → Embed a map → value of src="…")
PUBLIC_MAPS_EMBED_URL=

# --- Reservations: Google Sheets (server-only, secret) ------------------
# Apps Script web app URL ending in /exec (see docs/google-apps-script.gs)
GOOGLE_SHEETS_WEBHOOK_URL=
# Long random string; must match WEBHOOK_SECRET in the Apps Script
GOOGLE_SHEETS_WEBHOOK_SECRET=

# --- Deposit: PayPal.me link used by /deposit?ref=…&amount=… ------------
PUBLIC_PAYPAL_ME_URL=

# --- Analytics (optional) ------------------------------------------------
# GA4 Measurement ID, e.g. G-XXXXXXXXXX. Empty = no analytics loaded.
PUBLIC_GA4_ID=
