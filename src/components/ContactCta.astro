---
import Icon from './Icon.astro';
import SocialLinks from './SocialLinks.astro';
import Location from './Location.astro';
import { site, whatsappUrl } from '../data/site';
import { useT } from '../i18n/ui';
import { url, type Lang } from '../i18n/routes';

interface Props { lang: Lang; showLocation?: boolean }
const { lang, showLocation = true } = Astro.props;
const t = useT(lang);
const wa = whatsappUrl(t.whatsappGreeting);
const formHref = `${url(lang, 'contact')}#contact-form`;
---
<section class="section cta" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta__box">
      <p class="kicker">{t.contact.kicker}</p>
      <h2 id="cta-title">{t.contact.title}</h2>
      <p class="lead cta__quote">{t.contact.quote}</p>
      <div class="cta__buttons">
        {
          wa ? (
            <a class="btn btn--lg" href={wa} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-track-location="contact_section">
              <Icon name="whatsapp" />{t.contact.whatsapp}<span class="sr-only"> {t.newTab}</span>
            </a>
          ) : null
        }
        <a class="btn btn--lg btn--purple" href={formHref} data-track="contact_click" data-track-location="contact_section">
          <Icon name="form" />{t.contact.form}
        </a>
        {
          site.email && (
            <a class="btn btn--lg btn--blue" href={`mailto:${site.email}`} data-track="email_click" data-track-location="contact_section">
              <Icon name="mail" />{t.contact.email}
            </a>
          )
        }
      </div>
      <div class="cta__social">
        <SocialLinks lang={lang} />
      </div>
    </div>
    {showLocation && <Location lang={lang} />}
  </div>
</section>
<style>
  .cta__box {
    text-align: center; padding: var(--space-2xl) var(--space-lg); border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--coral) 9%, var(--bg)); border: 1px solid color-mix(in srgb, var(--coral) 35%, var(--border));
  }
  .cta__box .kicker { color: var(--coral-ink); }
  :global(:root[data-theme='dark']) .cta__box .kicker { color: #f0a283; }
  .cta__quote { margin: var(--space-sm) auto 0; max-width: 52ch; }
  .cta__buttons { display: grid; gap: var(--space-lg); margin-top: var(--space-xl); }
  @media (min-width: 640px) { .cta__buttons { display: flex; justify-content: center; flex-wrap: wrap; } }
  @media (min-width: 1024px) { .cta__buttons { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 240px); justify-content: center; } }
  .cta__social { display: flex; justify-content: center; margin-top: var(--space-lg); color: var(--text); }
</style>
