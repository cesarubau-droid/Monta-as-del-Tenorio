---
/**
 * Portada: una foto fija del Río Celeste que ocupa toda la pantalla.
 * Se mete por debajo del header (que aquí es transparente) gracias al margen negativo.
 */
import Photo from './Photo.astro';
import { useT } from '../i18n/ui';
import { url, type Lang } from '../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media">
    <Photo id="hero-forest-river" lang={lang} eager sizes="100vw" class="hero__img" alt="" />
  </div>

  <div class="hero__content">
    <div class="container">
      <h1 id="hero-title">
        <span class="hero__eyebrow">{t.hero.eyebrow}</span>
        {t.hero.title}
      </h1>
      <p class="hero__subtitle">{t.hero.subtitle}</p>
      <p class="hero__tagline">{t.hero.tagline}</p>
      <div class="btn-row hero__ctas">
        <a href={url(lang, 'reserve')} class="btn btn--lg btn--accent" data-track="reservation_start" data-track-location="hero">{t.hero.ctaPrimary}</a>
        <a href={url(lang, 'tours')} class="btn btn--lg btn--ghost-light" data-track="tour_click" data-track-location="hero">{t.hero.ctaSecondary}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative; isolation: isolate; display: flex; align-items: flex-end; color: #fff; overflow: hidden; background: var(--petrol);
    /* Toda la pantalla, contando el espacio del header que queda encima */
    margin-top: calc(-1 * var(--header-h) - 1px); /* + borde del header */
    min-height: 100vh;
    min-height: 100svh;
  }
  .hero__media { position: absolute; inset: 0; z-index: -1; }
  .hero__media :global(picture), .hero__media :global(img) { display: block; width: 100%; height: 100%; }
  .hero__media :global(img) { object-fit: cover; object-position: 50% 60%; }
  /* Overlay: arriba oscurece para el header, abajo para que el texto blanco cumpla AA */
  .hero__media::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.25) 12%, rgba(0, 0, 0, 0) 26%),
      linear-gradient(180deg, rgba(0, 0, 0, 0) 30%, rgba(0, 0, 0, 0.35) 55%, rgba(0, 0, 0, 0.78) 100%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.45) 0%, rgba(0, 0, 0, 0) 65%);
  }
  .hero__content { width: 100%; padding-block: calc(var(--header-h) + var(--space-2xl)) var(--space-3xl); }
  .hero h1 { color: #fff; max-width: 14ch; font-size: var(--fs-display); line-height: 1; text-shadow: 0 2px 16px rgba(0, 0, 0, 0.35); }
  .hero__eyebrow {
    display: block; margin-bottom: var(--space-md); max-width: 40ch;
    font-family: var(--font-sans); font-size: var(--fs-label); font-weight: 700; letter-spacing: 0.2em; line-height: 1.6; text-transform: uppercase;
    color: var(--celeste-soft); text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
  }
  .hero__subtitle { font-size: var(--fs-lg); font-weight: 600; margin-top: var(--space-md); }
  .hero__tagline { font-size: var(--fs-lg); line-height: 1.6; max-width: 46ch; margin-top: var(--space-xs); color: #f1f1f1; }
  .hero__ctas { margin-top: var(--space-lg); flex-direction: column; }
  .hero__ctas .btn { width: 100%; }
  @media (min-width: 640px) { .hero__ctas { flex-direction: row; } .hero__ctas .btn { width: auto; } }
</style>
