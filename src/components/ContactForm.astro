---
import Icon from './Icon.astro';
import { useT } from '../i18n/ui';
import { url, type Lang } from '../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const f = t.form;
const msgs = { ...f.errors, summary: f.errorSummary, sending: f.sending };
---
<form
  class="form"
  action="/api/inquiry"
  method="post"
  novalidate
  data-inquiry-form
  data-success="contact-success"
  data-msgs={JSON.stringify(msgs)}
>
  <input type="hidden" name="type" value="contact" />
  <input type="hidden" name="lang" value={lang} />
  <div class="hp" aria-hidden="true">
    <label for="c-website">Website</label>
    <input id="c-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <div class="form-status form-status--error" role="alert" tabindex="-1" data-form-status></div>

  <div class="form-row form-row--2">
    <div class="field">
      <label for="c-name">{f.name}<span class="req" aria-hidden="true"> *</span></label>
      <input id="c-name" name="name" type="text" autocomplete="name" required maxlength="100" aria-describedby="c-name-err" />
      <p class="error" id="c-name-err" data-error-for="name"></p>
    </div>
    <div class="field">
      <label for="c-email">{f.email}<span class="req" aria-hidden="true"> *</span></label>
      <input id="c-email" name="email" type="email" autocomplete="email" required maxlength="200" aria-describedby="c-email-err" />
      <p class="error" id="c-email-err" data-error-for="email"></p>
    </div>
  </div>
  <div class="field">
    <label for="c-message">{f.message}<span class="req" aria-hidden="true"> *</span></label>
    <textarea id="c-message" name="message" rows="5" required maxlength="2000" aria-describedby="c-message-err"></textarea>
    <p class="error" id="c-message-err" data-error-for="message"></p>
  </div>
  <div class="field">
    <label class="check" for="c-consent">
      <input id="c-consent" type="checkbox" name="consent" required aria-describedby="c-consent-err" />
      <span>{f.consent} <a href={url(lang, 'privacy')} class="text-link">{f.privacy}</a>.<span class="req" aria-hidden="true"> *</span></span>
    </label>
    <p class="error" id="c-consent-err" data-error-for="consent"></p>
  </div>
  <button type="submit" class="btn btn--lg btn--purple">{f.send}</button>
</form>

<div id="contact-success" class="form-success" tabindex="-1" hidden>
  <h3><Icon name="check" size={22} class="icon" /> {f.successTitle}</h3>
  <p>{f.successContact}</p>
</div>

<script>
  import { initInquiryForms } from '../scripts/forms';
  initInquiryForms();
</script>
