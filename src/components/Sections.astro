---
/**
 * Small shared section header.
 * <Sections title="…" lead="…" center id="…" />
 */
interface Props { title: string; lead?: string; center?: boolean; id?: string; level?: 'h1' | 'h2' }
const { title, lead, center = false, id, level: H = 'h2' } = Astro.props;
---
<div class:list={['section-head', { 'section-head--center': center }]}>
  <H id={id}>{title}</H>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</div>
