---
import Icon from './Icon.astro';
import { sustainability } from '../data/content';
import { useT } from '../i18n/ui';
import { url, type Lang } from '../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---
<section class="section band-green on-dark" aria-labelledby="sus-title">
  <div class="container sus">
    <div>
      <p class="kicker">{t.sustainability.kicker}</p>
      <h2 id="sus-title">{t.sustainability.title}</h2>
      <blockquote class="sus__quote"><p>“{t.sustainability.quote}”</p></blockquote>
    </div>
    <ul class="sus__list" role="list">
      {sustainability.map((s) => (
        <li>
          <a href={`${url(lang, 'sustainability')}#${s.id}`} class="sus__link">
            <span class="sus__icon"><Icon name={s.icon as 'leaf'} /></span>
            <span>
              <span class="sus__title">{s.title[lang]}</span>
              <span class="sus__text">{s.text[lang]}</span>
            </span>
            <Icon name="arrow" size={20} class="icon sus__arrow" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .sus { display: grid; gap: var(--space-xl); }
  @media (min-width: 900px) { .sus { grid-template-columns: 1fr 1.1fr; align-items: center; gap: var(--space-2xl); } }
  .sus__quote { margin: var(--space-lg) 0 0; padding-left: var(--space-md); border-left: 3px solid rgba(255, 255, 255, 0.7); }
  .sus__quote p { font-family: var(--font-serif); font-style: italic; font-size: var(--fs-lg); line-height: 1.6; }
  .sus__list { display: grid; gap: var(--space-sm); list-style: none; padding: 0; }
  .band-green a.sus__link {
    display: flex; align-items: center; gap: var(--space-md); padding: var(--space-md);
    border-radius: var(--radius-md); background: rgba(0, 0, 0, 0.14); color: #fff; text-decoration: none;
    transition: background-color 200ms ease;
  }
  .band-green a.sus__link:hover { background: rgba(0, 0, 0, 0.26); }
  .sus__icon { display: grid; place-items: center; flex: none; width: 48px; height: 48px; border-radius: 50%; background: rgba(255, 255, 255, 0.16); }
  .sus__title { display: block; font-weight: 700; }
  .sus__text { display: block; font-size: var(--fs-sm); line-height: 1.6; opacity: 0.95; }
  :global(.sus__arrow) { flex: none; margin-left: auto; }
</style>
