---
/** Renders only when real testimonials exist in src/data/content.ts. */
import Icon from './Icon.astro';
import SectionHead from './Sections.astro';
import { testimonials } from '../data/content';
import { useT, fmt } from '../i18n/ui';
import type { Lang } from '../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---
{
  testimonials.length > 0 && (
    <section class="section section--surface" aria-labelledby="testi-title">
      <div class="container">
        <SectionHead kicker={t.testimonials.kicker} title={t.testimonials.title} center id="testi-title" />
        <ul class="grid grid--3" role="list">
          {testimonials.slice(0, 3).map((r) => (
            <li class="testi">
              <figure>
                <span class="testi__stars" role="img" aria-label={fmt(t.testimonials.rating, { n: r.rating })}>
                  {Array.from({ length: Math.round(r.rating) }, () => <Icon name="star" size={18} />)}
                </span>
                <blockquote><p>“{r.quote[lang]}”</p></blockquote>
                <figcaption>
                  <strong>{r.name}</strong> · {r.country}{r.source && ` · ${r.source}`}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
<style>
  .testi { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); padding: var(--space-lg); }
  .testi__stars { display: inline-flex; color: #b8860b; }
  .testi blockquote { margin: var(--space-sm) 0; font-style: italic; }
  .testi figcaption { font-size: var(--fs-sm); color: var(--text-2); }
</style>
