---
import { useT } from '../i18n/ui';
import { url, type Lang } from '../i18n/routes';

interface Props { lang: Lang; title: string; lead?: string; kicker?: string; crumbs?: { label: string; href?: string }[] }
const { lang, title, lead, kicker, crumbs = [] } = Astro.props;
const t = useT(lang);
const trail = [{ label: t.nav.home, href: url(lang, 'home') }, ...crumbs];
---
<section class="page-hero">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        {trail.map((c, i) => (
          <li>{c.href && i < trail.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
        ))}
      </ol>
    </nav>
    {kicker && <p class="kicker">{kicker}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
