---
/** Reservations sent from the cart. Confirming blocks the cabin dates and tour spots. */
import Admin from '../../layouts/Admin.astro';
import { guard } from '../../lib/admin-auth';
import { hasDatabase } from '../../lib/db';
import { listReservations, setReservationStatus, type ReservationRow } from '../../lib/booking';
import { cabins, tours, formatMoney } from '../../data/offer';
import { useT } from '../../i18n/ui';

export const prerender = false;

const blocked = guard(Astro);
if (blocked) return blocked;

const t = useT('es');
const STATUS = { new: 'Nueva', confirmed: 'Confirmada', cancelled: 'Cancelada' } as const;
type Status = keyof typeof STATUS;

if (Astro.request.method === 'POST' && hasDatabase()) {
  const fd = await Astro.request.formData();
  const ref = String(fd.get('ref') ?? '');
  const status = String(fd.get('status') ?? '') as Status;
  if (ref && status in STATUS) {
    const res = await setReservationStatus(ref, status);
    const q = res.ok ? `ok=${encodeURIComponent(`${ref}: ${STATUS[status].toLowerCase()}`)}` : `err=${encodeURIComponent(ref)}`;
    return Astro.redirect(`/admin/?${q}&f=${Astro.url.searchParams.get('f') ?? ''}`);
  }
}

const filter = Astro.url.searchParams.get('f') ?? '';
const rows: ReservationRow[] = hasDatabase() ? await listReservations(filter in STATUS ? filter : undefined) : [];
const ok = Astro.url.searchParams.get('ok');
const err = Astro.url.searchParams.get('err');
const m = (n: number) => formatMoney(n, 'USD', 'es');
const d = (iso: string) => new Intl.DateTimeFormat('es-CR', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${iso.slice(0, 10)}T00:00:00Z`));
const cabinName = (s: string) => cabins.find((c) => c.slug === s)?.name.es ?? s;
const tourName = (s: string) => tours.find((x) => x.slug === s)?.name.es ?? s;
const tabs = [['', 'Todas'], ['new', 'Nuevas'], ['confirmed', 'Confirmadas'], ['cancelled', 'Canceladas']];
---
<Admin title="Reservas" current="reservas">
  {ok && <p class="adm__ok" role="status">Listo: {ok}.</p>}
  {err && <p class="adm__err" role="alert">No se pudo confirmar {err}: alguna fecha o cupo ya está ocupado por otra reserva confirmada o un bloqueo. Revisa las fechas antes de confirmar.</p>}

  <nav class="adm-tabs" aria-label="Filtrar por estado">
    {tabs.map(([k, label]) => <a href={`/admin/?f=${k}`} aria-current={filter === k ? 'true' : undefined}>{label}</a>)}
  </nav>

  {rows.length === 0 ? <p class="muted">No hay reservas{filter ? ' con este estado' : ''}.</p> : (
    <ul class="res-list adm-grid" role="list">
      {rows.map((r) => (
        <li class="adm-card res">
          <div class="res__head">
            <div>
              <p class="res__ref">{r.ref} <span class={`adm-badge adm-badge--${r.status}`}>{STATUS[r.status as Status] ?? r.status}</span></p>
              <p class="small muted">Recibida el {d(r.created_at)}</p>
            </div>
            <p class="res__total">{m(r.total)}</p>
          </div>
          <div class="res__body">
            <div>
              <p><strong>{r.name}</strong>{r.country && ` · ${r.country}`}</p>
              <p class="small"><a href={`mailto:${r.email}`}>{r.email}</a> · <a href={`https://wa.me/${r.phone.replace(/\D/g, '')}`} target="_blank" rel="noopener noreferrer">{r.phone}</a></p>
              {r.message && <p class="small muted res__msg">{r.message}</p>}
            </div>
            <ul class="small res__items" role="list">
              {r.cabins.map((c) => <li>🏠 {cabinName(c.cabin)}: {d(c.checkIn)} → {d(c.checkOut)} · {c.guests} personas · {m(c.amount)}</li>)}
              {r.tours.map((x) => <li>🧭 {tourName(x.tour)}: {d(x.date)} · {t.cart.slots[x.slot]} · {x.adults} adultos{x.children ? `, ${x.children} niños` : ''} · {m(x.amount)}</li>)}
            </ul>
          </div>
          <form method="post" class="res__actions" action={`/admin/?f=${filter}`}>
            <input type="hidden" name="ref" value={r.ref} />
            {r.status !== 'confirmed' && <button class="btn" name="status" value="confirmed">Confirmar</button>}
            {r.status !== 'cancelled' && <button class="btn btn--outline" name="status" value="cancelled">Cancelar</button>}
            {r.status !== 'new' && <button class="btn btn--outline" name="status" value="new">Volver a nueva</button>}
          </form>
        </li>
      ))}
    </ul>
  )}
</Admin>

<style>
  .res-list { list-style: none; padding: 0; }
  .res__head { display: flex; justify-content: space-between; gap: var(--space-md); align-items: flex-start; }
  .res__ref { font-weight: 600; }
  .res__total { font-family: var(--font-serif); font-size: 1.5rem; }
  .res__body { display: grid; gap: var(--space-md); margin-top: var(--space-md); }
  @media (min-width: 900px) { .res__body { grid-template-columns: 1fr 1.4fr; } }
  .res__msg { margin-top: 6px; white-space: pre-line; }
  .res__items { list-style: none; padding: 0; display: grid; gap: 4px; }
  .res__actions { display: flex; gap: var(--space-sm); flex-wrap: wrap; margin-top: var(--space-md); }
</style>
